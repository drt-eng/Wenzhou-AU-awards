import json
json_str = json.dumps(nominees_multi, indent=2, ensure_ascii=False)

with open('/mnt/agents/output/nominees.json', 'w', encoding='utf-8') as f:
    f.write(json_str)

print(f"Saved nominees.json with multiple entries per person")
print(f"Total nominees: {len(nominees_multi)}")
print(f"File size: {len(json_str)} characters")

# Show summary
from collections import Counter
name_counts = Counter(n['name'] for n in nominees_multi)
print("\n--- Multi-nomination summary ---")
for name, count in name_counts.items():
    if count > 1:
        cats = [n['category'] + ' / ' + n['subcategory'] for n in nominees_multi if n['name'] == name]
        print(f"\n{name}: {count} entries")
        for c in cats:
            print(f"  → {c}")
